# Rust build output
/target/
**/target/

# Runtime artefacts produced by the proxy
/obsidian.db
/obsidian.db-wal
/obsidian.db-shm
/plugins/

# Web UI build output and dependencies
/obsidian-webui/dist/
/obsidian-webui/node_modules/

# Local configuration and secrets — never commit these
/obsidian.toml
.env
.env.*
!.env.example

# Editor and OS noise
/.idea/
/.vscode/
*.swp
.DS_Store
Thumbs.db

# Mundos de Minecraft de prueba: 105 MB de binarios, se regeneran
/testbed/data/

# Bases SQLite del testbed: estado local, no código
testbed/proxy/*.db
testbed/proxy/*.db-shm
testbed/proxy/*.db-wal
